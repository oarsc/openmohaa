#!/bin/sh

# Script to run commands in docker. Execute it without parameters to build image.

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

if [ $# -eq 0 ]; then
    distrobox create --name moh --image open-mohaa --volume "$SCRIPT_DIR/..:/mohaa" --nvidia
    exit $?
fi

distrobox enter moh -- "$@"
